{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "otto://schemas/release-manifest",
  "title": "Otto Release Manifest",
  "description": "Release manifest that describes a product release, artifacts, rollout policy, and dependency requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "product",
    "channel",
    "released_at",
    "expires_at",
    "version",
    "artifacts",
    "release_notes",
    "rollout",
    "dependencies",
    "revoked",
    "revocation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "manifest_id": {
      "type": "string",
      "format": "uuid"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "channel": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "canary",
        "lts"
      ]
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver",
        "build",
        "major",
        "minor",
        "patch"
      ],
      "properties": {
        "semver": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "patch": {
          "type": "integer",
          "minimum": 0
        },
        "prerelease": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "platform",
          "arch",
          "url",
          "sha256",
          "size_bytes",
          "signature"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "platform": {
            "type": "string",
            "enum": [
              "linux",
              "macos",
              "windows"
            ]
          },
          "arch": {
            "type": "string",
            "enum": [
              "x64",
              "arm64",
              "x86"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "signature": {
            "type": "string",
            "minLength": 8
          },
          "notes": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "release_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "highlights",
        "breaking_changes"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "breaking_changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "staged_percentage",
        "canary_groups",
        "start_at"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "immediate",
            "staged",
            "canary"
          ]
        },
        "staged_percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "canary_groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "dependencies": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "constraint"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "constraint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "revocation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "revoked_at",
            "revoked_by"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "revoked_at": {
              "type": "string",
              "format": "date-time"
            },
            "revoked_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "manifest_id": "4f404754-a1d0-4cd5-b3f6-99e95666f739",
      "product": "otto-helper",
      "channel": "stable",
      "released_at": "2026-07-02T18:30:00Z",
      "expires_at": null,
      "version": {
        "semver": "1.8.0",
        "build": "20260702.1",
        "major": 1,
        "minor": 8,
        "patch": 0,
        "prerelease": null
      },
      "artifacts": [
        {
          "artifact_id": "otto-helper-macos-arm64",
          "platform": "macos",
          "arch": "arm64",
          "url": "https://updates.otto.local/otto-helper/1.8.0/otto-helper-macos-arm64.zip",
          "sha256": "2f6dbf922ba9456f7ed429f7f412bb2f953f7f6a4d4f8cdad9f6fdb28298a81b",
          "size_bytes": 14590720,
          "signature": "MEUCIG28q2r5bM0xg2vSmQn5eC8a2tZu6fJ3H1m1HnWk3Q0RAiEAzN8axwW2V7s1g3wq5k7m5iJ9XvH4fQ8Jr3A2q7z7S2A=",
          "notes": null
        }
      ],
      "release_notes": {
        "summary": "Adds safer staged rollout behavior and resolves startup telemetry lock contention.",
        "highlights": [
          "Improved update pipeline resiliency",
          "Faster startup checks on managed devices"
        ],
        "breaking_changes": [],
        "url": "https://docs.otto.local/releases/1.8.0"
      },
      "rollout": {
        "strategy": "staged",
        "staged_percentage": 25,
        "canary_groups": [
          "internal-qa"
        ],
        "start_at": "2026-07-02T19:00:00Z"
      },
      "dependencies": [
        {
          "name": "otto-kernel",
          "constraint": ">=1.7.61"
        }
      ],
      "revoked": false,
      "revocation": null
    }
  ]
}
